# Database: enable exactly one DATABASE_URL.
# SQLite (default; relative paths are resolved from the project root)
DATABASE_URL=sqlite:///data/personnel_eval.db
# MySQL 8.0+ (create the database first and keep utf8mb4 in the URL)
# DATABASE_URL=mysql+pymysql://personnel_user:change-me@127.0.0.1:3306/personnel_eval?charset=utf8mb4
# PostgreSQL 13+
# DATABASE_URL=postgresql+psycopg://personnel_user:change-me@127.0.0.1:5432/personnel_eval

# Connection pool settings apply to MySQL and PostgreSQL.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Optional defaults used by scripts/init_database.py.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=系统管理员
# Development default is password!; always override it in production.
INITIAL_ADMIN_PASSWORD=password!

# Authentication sessions. Enable secure cookies when the site is served over HTTPS.
SESSION_COOKIE_NAME=personnel_session
SESSION_MAX_AGE=28800
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO
LOG_JSON=true

# Generate with: python3 scripts/hash_password.py
SCORE_DETAIL_PASSWORD_HASH=
