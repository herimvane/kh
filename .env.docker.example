# Common application settings
APP_PORT=8000
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=系统管理员
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_COOKIE_NAME=personnel_session
SESSION_MAX_AGE=28800
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO
LOG_JSON=true
SCORE_DETAIL_PASSWORD_HASH=

# SQLite uses the named volume automatically. Leave this unset for SQLite.
# DOCKER_DATABASE_URL=sqlite:////app/data/personnel_eval.db

# MySQL overlay defaults. When changing these values, also set the complete,
# URL-encoded DOCKER_DATABASE_URL to the same credentials.
MYSQL_DATABASE=personnel_eval
MYSQL_USER=personnel
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
# DOCKER_DATABASE_URL=mysql+pymysql://personnel:change-me@mysql:3306/personnel_eval?charset=utf8mb4

# PostgreSQL overlay defaults. When changing these values, also set the
# complete, URL-encoded DOCKER_DATABASE_URL to the same credentials.
POSTGRES_DB=personnel_eval
POSTGRES_USER=personnel
POSTGRES_PASSWORD=change-me
# DOCKER_DATABASE_URL=postgresql+psycopg://personnel:change-me@postgres:5432/personnel_eval
